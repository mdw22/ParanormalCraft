{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            // One click: the NeoForge server, then the client joining it (tools/playtest.sh). Then click [Start …] in chat.
            "label": "▶ Playtest",
            "detail": "Starts the NeoForge server, waits for it, then starts the client and joins. Then click [Start …] in chat.",
            "type": "shell",
            "command": "./tools/playtest.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "NeoForge client",
            "type": "shell",
            "command": "./gradlew :neoforge:runClient",
            "problemMatcher": []
        },
        {
            "label": "NeoForge client 2 (Dev2)",
            "type": "shell",
            "command": "./gradlew :neoforge:runClient2",
            "problemMatcher": []
        },
        {
            "label": "NeoForge server",
            "type": "shell",
            "command": "./gradlew :neoforge:runServer",
            "problemMatcher": []
        },
        {
            "label": "Fabric client",
            "type": "shell",
            "command": "./gradlew :fabric:runClient",
            "problemMatcher": []
        },
        {
            "label": "Fabric server",
            "type": "shell",
            "command": "./gradlew :fabric:runServer",
            "problemMatcher": []
        },
        {
            "label": "Build all",
            "type": "shell",
            "command": "./gradlew build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "NeoForge data gen",
            "type": "shell",
            "command": "./gradlew :neoforge:runData",
            "problemMatcher": []
        },
        {
            // Used by the "Debug NeoForge client" launch config: starts the client suspended on port 5005
            // and tells VS Code it is ready once the JVM is listening for the debugger.
            "label": "NeoForge client (debug)",
            "type": "shell",
            "command": "./gradlew :neoforge:runClient -PdebugClient",
            "isBackground": true,
            "problemMatcher": {
                "owner": "gradle-debug",
                "pattern": {
                    "regexp": "^__never_matches__$"
                },
                "background": {
                    "beginsPattern": "^.*(Starting a Gradle Daemon|Configure project|Task :).*$",
                    "endsPattern": "^.*Listening for transport dt_socket at address: 5005.*$"
                }
            }
        },
        {
            // Used by the "Debug NeoForge server" launch config: starts the dev server suspended on port 5006.
            "label": "NeoForge server (debug)",
            "type": "shell",
            "command": "./gradlew :neoforge:runServer -PdebugServer",
            "isBackground": true,
            "problemMatcher": {
                "owner": "gradle-debug",
                "pattern": {
                    "regexp": "^__never_matches__$"
                },
                "background": {
                    "beginsPattern": "^.*(Starting a Gradle Daemon|Configure project|Task :).*$",
                    "endsPattern": "^.*Listening for transport dt_socket at address: 5006.*$"
                }
            }
        }
    ]
}
